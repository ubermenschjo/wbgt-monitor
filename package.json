{
  "name": "wbgt-monitor",
  "version": "1.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:biz": "APP_FLAVOR=biz expo start",
    "start:consumer": "APP_FLAVOR=consumer expo start",
    "update:biz:preview": "APP_FLAVOR=biz eas update --channel preview --environment production",
    "update:biz:production": "APP_FLAVOR=biz eas update --channel production --environment production",
    "update:consumer:preview": "APP_FLAVOR=consumer eas update --channel preview --environment production",
    "update:consumer:production": "APP_FLAVOR=consumer eas update --channel production --environment production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bittingz/expo-widgets": "^3.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "expo": "~54.0.0",
    "expo-background-fetch": "~14.0.9",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-purchases": "^10.2.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-classes": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^20.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@bittingz/expo-widgets"
        ]
      }
    }
  },
  "private": true
}
