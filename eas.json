{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-biz": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_FLAVOR": "biz" }
    },
    "development-consumer": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_FLAVOR": "consumer" }
    },
    "preview-biz": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": { "APP_FLAVOR": "biz" }
    },
    "preview-consumer": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": { "APP_FLAVOR": "consumer" }
    },
    "production-biz": {
      "channel": "production",
      "ios": {
        "distribution": "store",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": { "APP_FLAVOR": "biz" }
    },
    "production-consumer": {
      "channel": "production",
      "ios": {
        "distribution": "store",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": { "APP_FLAVOR": "consumer" }
    }
  },
  "submit": {
    "internal-android-biz": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "internal-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "alpha-android-biz": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "alpha-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "beta-android-biz": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "beta-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production-android-biz": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "production-android-biz-draft": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "production-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "production-android-consumer-draft": {
      "android": {
        "serviceAccountKeyPath": "secrets/google-play-key.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "testflight-ios-biz": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID_BIZ",
        "appleTeamId": "$APPLE_TEAM_ID"
      }
    },
    "testflight-ios-consumer": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID_CONSUMER",
        "appleTeamId": "$APPLE_TEAM_ID"
      }
    },
    "production-ios-biz": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID_BIZ",
        "appleTeamId": "$APPLE_TEAM_ID"
      }
    },
    "production-ios-consumer": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$ASC_APP_ID_CONSUMER",
        "appleTeamId": "$APPLE_TEAM_ID"
      }
    }
  }
}
