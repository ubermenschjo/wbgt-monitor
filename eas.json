{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-biz": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_FLAVOR": "biz" }
    },
    "development-consumer": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_FLAVOR": "consumer" }
    },
    "preview-biz": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": { "APP_FLAVOR": "biz" }
    },
    "preview-consumer": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": { "APP_FLAVOR": "consumer" }
    },
    "production-biz": {
      "channel": "production",
      "environment": "production",
      "ios": {
        "distribution": "store",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": { "APP_FLAVOR": "biz" }
    },
    "production-consumer": {
      "channel": "production",
      "environment": "production",
      "ios": {
        "distribution": "store",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": { "APP_FLAVOR": "consumer" }
    }
  },
  "submit": {
    "internal-android-biz": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "internal-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "alpha-android-biz": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "alpha-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "beta-android-biz": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "beta-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production-android-biz": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "production-android-biz-draft": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "production-android-consumer": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "production-android-consumer-draft": {
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_JSON_KEY_PATH",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "testflight-ios-biz": {
      "ios": {
        "appleId": "dev@sta3e-n.com",
        "ascAppId": "6780710276",
        "appleTeamId": "V8R9XYRK99",
        "bundleIdentifier": "com.stagen.wbgt.biz",
        "companyName": "株式会社 ｓｔａｇｅ　N",
        "language": "ja",
        "sku": "com.stagen.wbgt.biz",
        "metadataPath": "store.config.apple.biz.json"
      }
    },
    "testflight-ios-consumer": {
      "ios": {
        "appleId": "dev@sta3e-n.com",
        "ascAppId": "6780366425",
        "appleTeamId": "V8R9XYRK99",
        "bundleIdentifier": "com.stagen.wbgt.consumer",
        "companyName": "株式会社 ｓｔａｇｅ　N",
        "language": "ja",
        "sku": "com.stagen.wbgt.consumer",
        "metadataPath": "store.config.apple.consumer.json"
      }
    },
    "production-ios-biz": {
      "extends": "testflight-ios-biz"
    },
    "production-ios-consumer": {
      "extends": "testflight-ios-consumer"
    }
  }
}
